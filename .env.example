# ── Auth0 Configuration ──
# Required for authentication (Twitter OAuth)
AUTH0_SECRET=your-auth0-secret-min-32-chars
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# ── Database ──
# Required for Prisma (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/arvindravi?schema=public

# ── PlanetScale (Optional - if using PlanetScale instead of direct PostgreSQL)
# PLANETSCALE_SERVICE_TOKEN=your-token
# PLANETSCALE_DATABASE_URL=your-database-url

# ── Postmark (Email) ──
# Required for email notifications
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# ── Vercel Blob (Image Uploads) ──
# Required for photograph + stack image uploads.
# Create a Blob store in the Vercel dashboard (Storage → Blob), connect it
# to this project, then copy the read/write token here for local development.
# On Vercel deployments this is injected automatically once the store is linked.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token

# ── Fathom Analytics (Optional) ──
# FATHOM_SITE_ID=your-fathom-site-id

# ── Environment ──
# NODE_ENV is set automatically by Next.js. Do NOT set it here.
