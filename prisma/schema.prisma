generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["referentialIntegrity"]
}

datasource db {
  provider             = "postgresql"
  url                  = env("DATABASE_URL")
  shadowDatabaseUrl    = env("SHADOW_DATABASE_URL")
  referentialIntegrity = "prisma"
}

model User {
  id           String     @id(map: "idx_24641_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  role         User_role  @default(USER)
  username     String     @unique(map: "idx_24641_User_username_key") @db.VarChar(16)
  twitterId    String     @unique(map: "idx_24641_User_twitterId_key") @db.VarChar(191)
  email        String?    @unique(map: "idx_24641_User_email_key") @db.VarChar(191)
  pendingEmail String?    @db.VarChar(191)
  avatar       String?    @db.VarChar(191)
  description  String?    @db.VarChar(256)
  location     String?    @db.VarChar(32)
  name         String?    @db.VarChar(191)
  nickname     String?    @db.VarChar(191)
  comments     Comment[]
  questions    Question[]
  reactions    Reaction[]
  posts        Post[]
  stacks       Stack[]
}

model Bookmark {
  id            String     @id(map: "idx_24593_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)
  url           String     @unique(map: "idx_24593_Bookmark_url_key") @db.VarChar(512)
  host          String?    @db.VarChar(191)
  title         String?    @db.VarChar(280)
  image         String?    @db.VarChar(512)
  description   String?    @db.VarChar(2048)
  twitterHandle String?    @db.VarChar(191)
  faviconUrl    String?    @db.VarChar(191)
  comments      Comment[]
  reactions     Reaction[]
  tags          Tag[]

  @@index([host], map: "idx_24593_Bookmark_host_idx")
}

model Question {
  id          String     @id(map: "idx_24620_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  author      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String     @db.VarChar(256)
  description String?    @db.VarChar(1024)
  userId      String     @db.VarChar(191)
  comments    Comment[]
  reactions   Reaction[]
}

model Comment {
  id         String     @id(map: "idx_24599_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt  DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(6)
  text       String
  audio      Audio?
  reactions  Reaction[]
  author     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String     @db.VarChar(191)
  bookmark   Bookmark?  @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  question   Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  post       Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  stack      Stack?     @relation(fields: [stackId], references: [id], onDelete: Cascade)
  bookmarkId String?    @db.VarChar(191)
  questionId String?    @db.VarChar(191)
  postId     String?    @db.VarChar(191)
  stackId    String?    @db.VarChar(191)

  @@index([bookmarkId], map: "idx_24599_Comment_bookmarkId_idx")
  @@index([postId], map: "idx_24599_Comment_postId_idx")
  @@index([questionId], map: "idx_24599_Comment_questionId_idx")
  @@index([stackId], map: "idx_24599_Comment_stackId_idx")
}

model Audio {
  id            String   @id(map: "idx_24587_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  plays         Int
  waveform      Json     @db.Json
  url           String   @db.VarChar(191)
  transcription String   @db.VarChar(191)
  comment       Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId     String   @unique(map: "idx_24587_Audio_commentId_key") @db.VarChar(191)
}

model Post {
  id           String     @id(map: "idx_24608_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  publishedAt  DateTime?  @db.Timestamptz(6)
  author       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug         String     @unique(map: "idx_24608_Post_slug_key") @db.VarChar(191)
  title        String     @db.VarChar(280)
  text         String
  excerpt      String     @db.VarChar(280)
  featureImage String?    @db.VarChar(191)
  comments     Comment[]
  reactions    Reaction[]
  history      PostEdit[]
  userId       String     @db.VarChar(191)

  @@index([publishedAt], map: "idx_24608_Post_publishedAt_idx")
}

model PostEdit {
  id           String   @id(map: "idx_24614_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  text         String
  title        String   @db.VarChar(280)
  excerpt      String   @db.VarChar(280)
  featureImage String?  @db.VarChar(191)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String?  @db.VarChar(191)

  @@index([postId], map: "idx_24614_PostEdit_postId_idx")
}

model Tag {
  id        String     @id(map: "idx_24638_PRIMARY") @default(cuid()) @db.VarChar(191)
  name      String     @unique(map: "idx_24638_Tag_name_key") @db.VarChar(191)
  stacks    Stack[]
  bookmarks Bookmark[]
}

model Stack {
  id          String     @id(map: "idx_24632_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  name        String     @db.VarChar(191)
  slug        String?    @unique(map: "idx_24632_Stack_slug_key") @db.VarChar(191)
  description String     @db.VarChar(280)
  image       String     @db.VarChar(191)
  url         String     @db.VarChar(191)
  tags        Tag[]
  comments    Comment[]
  reactions   Reaction[]
  users       User[]
}

model Reaction {
  id         String    @id(map: "idx_24626_PRIMARY") @default(cuid()) @db.VarChar(191)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.VarChar(191)
  bookmark   Bookmark? @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  stack      Stack?    @relation(fields: [stackId], references: [id], onDelete: Cascade)
  commentId  String?   @db.VarChar(191)
  bookmarkId String?   @db.VarChar(191)
  questionId String?   @db.VarChar(191)
  postId     String?   @db.VarChar(191)
  stackId    String?   @db.VarChar(191)

  @@index([bookmarkId], map: "idx_24626_Reaction_bookmarkId_idx")
  @@index([commentId], map: "idx_24626_Reaction_commentId_idx")
  @@index([postId], map: "idx_24626_Reaction_postId_idx")
  @@index([questionId], map: "idx_24626_Reaction_questionId_idx")
  @@index([stackId], map: "idx_24626_Reaction_stackId_idx")
}

model EmailSubscription {
  email String                 @db.VarChar(191)
  type  EmailSubscription_type

  @@unique([email, type], map: "idx_24605_EmailSubscription_email_type_key")
  @@index([email], map: "idx_24605_EmailSubscription_email_idx")
}

model BookmarkToTag {
  A String @db.VarChar(191)
  B String @db.VarChar(191)

  @@unique([A, B], map: "idx_24648__BookmarkToTag_AB_unique")
  @@index([B], map: "idx_24648__BookmarkToTag_B_index")
  @@map("_BookmarkToTag")
}

model StackToTag {
  A String @db.VarChar(191)
  B String @db.VarChar(191)

  @@unique([A, B], map: "idx_24651__StackToTag_AB_unique")
  @@index([B], map: "idx_24651__StackToTag_B_index")
  @@map("_StackToTag")
}

model StackToUser {
  A String @db.VarChar(191)
  B String @db.VarChar(191)

  @@unique([A, B], map: "idx_24654__StackToUser_AB_unique")
  @@index([B], map: "idx_24654__StackToUser_B_index")
  @@map("_StackToUser")
}

enum EmailSubscription_type {
  HACKER_NEWS
}

enum User_role {
  BLOCKED
  USER
  ADMIN
}
